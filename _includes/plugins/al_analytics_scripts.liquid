{% comment %}
  Parse-safe wrapper for al_analytics custom tag.
  Local override: also loads GoatCounter, which al_analytics does not support,
  and _includes/site_extras.liquid (the theme has no other site-wide hook).
{% endcomment %}
{% al_analytics_scripts %}
{% if site.enable_goatcounter_analytics and site.goatcounter_analytics %}
  <script defer src="{{ '/assets/js/goatcounter-events.js' | relative_url | bust_file_cache }}"></script>
  <script
    data-goatcounter="https://{{ site.goatcounter_analytics }}.goatcounter.com/count"
    async
    src="https://gc.zgo.at/count.js"
  ></script>
{% endif %}
{% include site_extras.liquid %}
